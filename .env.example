# Detroit Pulse environment. Copy to .env (chmod 600) and fill in the secrets.
# .env is gitignored; never commit real values. Every variable has a default in
# core/settings.py except the secrets marked REQUIRED.

# ── Anthropic (extraction) ──────────────────────────────────────────────────
# REQUIRED for Claude extraction; empty => rules-only
ANTHROPIC_API_KEY=
# false => never call Claude (rules-only extraction)
LLM_ENABLED=true
LLM_MODEL=claude-haiku-5-5
# thinking is disabled; effort stays <= high
LLM_EFFORT=medium
# transmissions per call
LLM_BATCH_SIZE=10
# flush a partial batch after this many seconds
LLM_BATCH_MAX_WAIT_S=45
# 1h: batches arrive >5 min apart at low volume
LLM_CACHE_TTL=1h
# SDK retries (429/5xx); spend-limit errors never retry
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60
# built by scripts/build_fewshots.py (TRAIN set only)
LLM_FEWSHOT_FILE=config/fewshots.local.jsonl
# hit => rules-only until UTC midnight
LLM_DAILY_CAP_USD=1.00
# hit => rules-only until the 1st (UTC)
LLM_MONTHLY_CAP_USD=15.00
LLM_PRICE_FILE=config/llm_prices.yaml
# on_close | rate_limited | off
SUMMARY_MODE=on_close
# rate_limited: at most one summary per incident per N s
SUMMARY_MIN_INTERVAL_S=900
# summaries read only the last N transmissions
SUMMARY_MAX_CHUNKS=15

# ── Postgres / PostGIS (docker-compose, 127.0.0.1:5436) ─────────────────────
POSTGRES_USER=pulse
# REQUIRED (compose refuses to start without it)
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5436
POSTGRES_DB=detroitpulse
# optional override
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5436/detroitpulse
# host port compose publishes (127.0.0.1 only)
PULSE_PG_PORT=5436

# ── Redis (docker-compose, 127.0.0.1:6381, requirepass) ─────────────────────
# REQUIRED
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_DB=0
# optional override
# REDIS_URL=redis://:pass@127.0.0.1:6381/0
PULSE_REDIS_PORT=6381

# ── API (127.0.0.1:7710) ────────────────────────────────────────────────────
# keep loopback; the gateway proxies to it
PULSE_API_HOST=127.0.0.1
PULSE_API_PORT=7710
# e.g. /pulse/api when the gateway strips that prefix
PULSE_ROOT_PATH=
# shared secret with the gateway (PULSE_API_TOKEN there too). Set => every API route except
# /v1/health requires "Authorization: Bearer <token>". Unset only for local development.
PULSE_API_TOKEN=
# unset => every /admin route returns 404. Admin requests send "X-Pulse-Admin-Token: <token>";
# the gateway blocks /admin, so admin is reachable only on the box (e.g. over an SSH tunnel).
PULSE_ADMIN_TOKEN=
# comma list; empty => same-origin only
PULSE_CORS_ORIGINS=
# expose /docs and /openapi.json
PULSE_DOCS_ENABLED=false

# ── Ingest ──────────────────────────────────────────────────────────────────
# comma list: sdr_files,traintap,fixture,broadcastify_legacy
INGEST_SOURCES=sdr_files
# rtl_airband `directory` (split_on_transmission files)
SDR_WATCH_DIR=data/sdr
# rtl_airband names files in UTC unless `localtime = true`
SDR_FILENAME_TZ=UTC
# wait until a file stops changing
SDR_MIN_FILE_AGE_S=1.5
SDR_POLL_INTERVAL_S=1.0
SDR_DELETE_AFTER_TRANSCRIBE=false
# traintap --csv output (tailed)
TRAINTAP_CSV=data/traintap/trains.csv
TRAINTAP_CHANNEL=eot_hot
# receiver heartbeats for /v1/feeds/status: <name>.prom (rtl_airband stats_filepath) or
# <name>.heartbeat (traintap --heartbeat); docs/sdr-ingest.md#6-receiver-heartbeats
RECEIVER_STATUS_DIR=data/receivers
# a heartbeat older than this (seconds) => receiver "offline"
RECEIVER_STALE_S=300
# Liveness history for /v1/rail/activity `verdicts` (core/liveness.py): the ingest stage
# (sdr_files, traintap) beats every INGEST_HEARTBEAT_S and records its receivers' heartbeats;
# a gap longer than LIVENESS_MAX_GAP_S ends a run, so "quiet" can't be claimed across it.
INGEST_HEARTBEAT_S=15
LIVENESS_MAX_GAP_S=150
LIVENESS_KEEP_DAYS=3
FIXTURE_DIR=tests/fixtures
# Broadcastify Terms §9 forbid automated capture and AI
BROADCASTIFY_LEGACY_ENABLED=false
# transcription; both must be true for the legacy source to run
BROADCASTIFY_TOS_ACKNOWLEDGED=false

# ── Transcription (faster-whisper, CPU) ─────────────────────────────────────
# medium.en: ~2.5x slower, better on noisy audio
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
# this CPU has no float16
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=5
# HF cache dir; default ~/.cache/huggingface
# WHISPER_DOWNLOAD_ROOT=
# Silero VAD via onnxruntime (no torch)
WHISPER_VAD_FILTER=true
WHISPER_CONTEXT_WINDOW_S=300

# ── Correlation / lifecycle ─────────────────────────────────────────────────
# one idle timeout for every resolver
INCIDENT_IDLE_RESOLVE_S=14400
INCIDENT_CANDIDATE_WINDOW_S=28800
CORRELATION_MATCH_THRESHOLD=0.50
RESOLVER_INTERVAL_S=120

# ── Geocoding ($0 providers only; Google is removed) ────────────────────────
# order tried; add nominatim to enable it. `local` = the index from scripts/build_geocoder_index.py
GEOCODER_PROVIDERS=local,census,photon
# geocoder downloads + index live OUTSIDE the repo (default $XDG_DATA_HOME/detroit-pulse/geocoder,
# i.e. ~/.local/share/detroit-pulse/geocoder); the index is <data dir>/index unless overridden
# GEOCODER_DATA_DIR=~/.local/share/detroit-pulse/geocoder
# GEOCODER_LOCAL_INDEX=~/.local/share/detroit-pulse/geocoder/index
# module:Class of the index backend
# GEOCODER_LOCAL_BACKEND=geocode.local:LocalGeocoder
GEOCODER_USER_AGENT=detroit-pulse-geocoder/0.2 (self-hosted)
GEOCODER_TIMEOUT_S=6
# public: max 1 req/s, cached
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_S=1.0
# or a self-hosted Photon
PHOTON_URL=https://photon.komoot.io
CENSUS_URL=https://geocoding.geo.census.gov
GEOCODE_CACHE_TTL_DAYS=30
GEOCODE_FAIL_CACHE_TTL_HOURS=24

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
